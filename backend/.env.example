# 火山方舟 (Volcano Ark) 配置
# 用法：复制本文件为 .env，填入真实值
# API Key 获取：https://console.volcengine.com/ark → 「API Key 管理」

# API Key。留空时跳过 AI 识别，衣物仍可正常抠图入库（语义字段为 null）
SEEDREAM_API_KEY=

# 衣物识别用的视觉理解模型 ID（以控制台「开通管理」页面显示的为准）
SEEDREAM_VISION_MODEL=doubao-seed-2-1-lite-260915

# 图像生成/编辑模型 ID（阶段四 AI 试穿用）
SEEDREAM_IMAGE_MODEL=doubao-seedream-4-0-250828

# 火山方舟 API 地址（北京区，一般不用改）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3


# ---------- 登录认证 ----------

# 登录密码的 PBKDF2 哈希。**不要手写**，用脚本生成（在 backend 目录运行）：
#   ./venv/Scripts/python.exe scripts/set_password.py
# 留空时登录端点返回 503，提示去设置密码；留空期间没有任何会话能通过鉴权。
# 改完必须重启后端：旧会话 cookie 会立即失效（签名密钥派生自这个哈希）。
APP_PASSWORD_HASH=

# 会话 cookie 是否加 Secure 标记。仅 HTTPS 部署时设为 true；
# http 下设为 true 会「登录成功但立刻未登录」（浏览器不回传带 Secure 的 cookie）。
APP_COOKIE_SECURE=false
